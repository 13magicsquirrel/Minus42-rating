<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="Fruit Squad">
<meta name="mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#FFF9E6">
<meta name="format-detection" content="telephone=no">
<title>Fruit Squad — by minus42</title>
<link rel="apple-touch-icon" href="data:image/png;base64,">
<link rel="icon" type="image/png" href="data:image/png;base64,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Baloo+2:wght@500..800&family=Just+Another+Hand&family=Raleway:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
/* ============================================================
   FRUIT SQUAD — a Minus42 play app for 8–10 year olds
   Brand tokens from the Minus42 design language.
   ============================================================ */
:root{
  --m42-orange:#FF6F1E; --m42-orange-deep:#C24E0B; --m42-orange-tint:#FFF0E6;
  --m42-ink:#18180F; --m42-body:#3D3D3D; --m42-ink3:#6B6B5A;
  --m42-cream:#FFF9E6; --m42-cream-deep:#FFF0CA; --m42-warm:#F2EFE3; --m42-white:#fff;
  --m42-leaf:#87A143; --m42-lime:#C0BE42; --m42-green-dk:#6E6C1E; --m42-green-tint:#F5F5E2;
  --m42-green-bright:#6EA71D; --m42-forest:#16281C;
  --m42-berry:#961254; --m42-gold:#FFC935; --m42-coral:#E2574C; --m42-border:#DCD8C4;
  --m42-font-display:"Baloo 2",system-ui,sans-serif;
  --m42-font-poster:"Anton",sans-serif;
  --m42-font-body:"Raleway",sans-serif;
  --m42-font-hand:"Just Another Hand",cursive;
  --m42-shadow-card:0 10px 40px rgb(24 24 15 / .10);
  --m42-shadow-soft:0 3px 14px rgb(24 24 15 / .07);
  --pad-t:env(safe-area-inset-top); --pad-b:env(safe-area-inset-bottom);
}
*{box-sizing:border-box; -webkit-tap-highlight-color:transparent; -webkit-touch-callout:none;}
html,body{height:100%; margin:0; overflow:hidden; overscroll-behavior:none;}
body{
  font-family:var(--m42-font-body); color:var(--m42-body);
  background:
    radial-gradient(1200px 700px at 12% 4%, #FFFCEF 0%, rgba(255,252,239,0) 60%),
    radial-gradient(1100px 800px at 100% 100%, #FFF2CE 0%, rgba(255,242,206,0) 55%),
    var(--m42-cream);
  user-select:none; -webkit-user-select:none; touch-action:manipulation;
  -webkit-text-size-adjust:100%;
}
/* warm paper grain */
body::after{
  content:""; position:fixed; inset:0; pointer-events:none; opacity:.5; z-index:1;
  background-image:radial-gradient(rgba(24,24,15,.035) 1px, transparent 1.4px);
  background-size:8px 8px; mix-blend-mode:multiply;
}
button{font-family:inherit; cursor:pointer; border:0; background:none; color:inherit;}
a{text-decoration:none; color:inherit;}
img{-webkit-user-drag:none; user-drag:none;}

/* ---------- app shell ---------- */
.app{position:relative; z-index:2; width:100vw; height:100vh;}
@supports (height:100dvh){ .app{height:100dvh;} }
/* iPad Air / iPad 9–10 in landscape with Safari chrome: keep the clock + title tight */
@media (orientation:landscape) and (max-height:740px){
  .gtitle{margin:clamp(2px,.6vh,8px) 0 clamp(2px,.5vh,6px);}
  .gtitle p{display:none;}                 /* the how-to line yields first */
  .footline{display:none;}
}
@media (orientation:landscape) and (max-height:640px){
  .gtitle h2{font-size:clamp(1.05rem,3.1vh,1.5rem);}
  .gtitle .kicker{display:none;}
}
.screen{
  position:absolute; inset:0; display:none; flex-direction:column;
  padding:calc(14px + var(--pad-t)) clamp(16px,3vw,42px) calc(14px + var(--pad-b));
}
.screen.on{display:flex; animation:fadeIn .32s ease both;}
@keyframes fadeIn{from{opacity:0; transform:translateY(8px)} to{opacity:1; transform:none}}

/* decorative sun */
.sun{position:fixed; top:-118px; right:-118px; width:300px; height:300px; opacity:.6; z-index:0; pointer-events:none;}

/* ---------- shared bits ---------- */
.kicker{
  font-weight:800; text-transform:uppercase; letter-spacing:.16em; color:var(--m42-green-dk);
  font-size:clamp(.62rem,1.3vh,.82rem); margin:0; display:flex; align-items:center; gap:9px;
}
.kicker .dot{width:7px; height:7px; border-radius:50%; background:var(--m42-orange);}
.pill{
  display:inline-flex; align-items:center; justify-content:center; gap:10px;
  border-radius:9999px; font-family:var(--m42-font-display); font-weight:800;
  letter-spacing:.01em; line-height:1;
}
.btn-primary{
  background:linear-gradient(180deg,#FF7A2E,#FF6F1E 55%,#F0640F); color:#fff;
  box-shadow:0 10px 0 #9c3f09, 0 18px 30px rgba(194,78,11,.30);
  padding:clamp(15px,2.3vh,22px) clamp(30px,4vw,54px);
  font-size:clamp(1.1rem,2.6vh,1.7rem); text-transform:uppercase;
  transition:transform .1s ease, box-shadow .1s ease;
}
.btn-primary:active{transform:translateY(7px); box-shadow:0 3px 0 #9c3f09, 0 6px 12px rgba(194,78,11,.3);}
.btn-ghost{
  background:#fff; color:var(--m42-ink); border:2px solid var(--m42-border);
  padding:clamp(12px,1.8vh,17px) clamp(20px,3vw,34px); font-size:clamp(.9rem,2vh,1.15rem);
  box-shadow:var(--m42-shadow-soft); transition:transform .1s ease, border-color .15s;
}
.btn-ghost:active{transform:scale(.96);}
.btn-green{
  background:linear-gradient(180deg,#7DBB24,#6EA71D 60%,#5C8C16); color:#fff;
  box-shadow:0 9px 0 #46700f, 0 16px 26px rgba(92,140,22,.28);
  padding:clamp(14px,2.1vh,20px) clamp(24px,3.4vw,44px); font-size:clamp(1rem,2.3vh,1.45rem);
  text-transform:uppercase; transition:transform .1s ease, box-shadow .1s ease;
}
.btn-green:active{transform:translateY(6px); box-shadow:0 3px 0 #46700f, 0 6px 10px rgba(92,140,22,.3);}
.card{
  background:var(--m42-white); border:1px solid var(--m42-border); border-radius:26px;
  box-shadow:var(--m42-shadow-card);
}

/* ---------- top bar (in game) ---------- */
.bar{display:flex; align-items:center; gap:clamp(10px,1.6vw,18px); flex:none;}
.bar .logo{height:clamp(34px,5.4vh,52px); width:auto;}
.bar .spacer{flex:1;}
.iconbtn{
  width:clamp(42px,6vh,54px); height:clamp(42px,6vh,54px); border-radius:50%;
  background:#fff; border:1.5px solid var(--m42-border); display:grid; place-items:center;
  box-shadow:var(--m42-shadow-soft); transition:transform .1s ease;
}
.iconbtn:active{transform:scale(.92);}
.iconbtn svg{width:52%; height:52%;}
.dots{display:flex; gap:8px; align-items:center;}
.dots i{
  width:clamp(9px,1.3vh,12px); height:clamp(9px,1.3vh,12px); border-radius:50%;
  background:#E9E2C6; display:block; transition:background .25s, transform .25s;
}
.dots i.done{background:var(--m42-lime);}
.dots i.now{background:var(--m42-orange); transform:scale(1.45);}
.scorechip{
  display:inline-flex; align-items:center; gap:7px; background:var(--m42-green-tint);
  border:1.5px solid #d9dcae; color:var(--m42-green-dk); border-radius:9999px;
  padding:7px 15px; font-weight:800; font-size:clamp(.74rem,1.5vh,.95rem); white-space:nowrap;
}
.scorechip b{color:var(--m42-orange); font-size:1.12em;}

/* countdown clock */
.timechip{
  display:inline-flex; align-items:center; gap:8px; background:#fff;
  border:1.5px solid var(--m42-border); color:var(--m42-ink); border-radius:9999px;
  padding:6px 16px 6px 9px; font-family:var(--m42-font-display); font-weight:800;
  font-size:clamp(.85rem,1.8vh,1.15rem); white-space:nowrap; box-shadow:var(--m42-shadow-soft);
  transition:background .25s, border-color .25s, color .25s;
}
.timechip .ring{
  width:clamp(20px,2.8vh,26px); height:clamp(20px,2.8vh,26px); flex:none; transform:rotate(-90deg);
}
.timechip .ring circle{fill:none; stroke-width:3.4; stroke-linecap:round;}
.timechip .ring .bg{stroke:#EDE6CC;}
.timechip .ring .fg{stroke:var(--m42-lime); transition:stroke-dashoffset .95s linear, stroke .3s;}
.timechip.warn{background:var(--m42-orange-tint); border-color:#F6C7A4; color:var(--m42-orange-deep);}
.timechip.warn .ring .fg{stroke:var(--m42-orange);}
.timechip.warn{animation:tick 1s steps(2) infinite;}
@keyframes tick{0%,100%{transform:scale(1)}50%{transform:scale(1.045)}}
@media (prefers-reduced-motion:reduce){ .timechip.warn{animation:none;} }

/* game title row */
.gtitle{flex:none; text-align:center; margin:clamp(6px,1.4vh,16px) 0 clamp(4px,1vh,10px);}
.gtitle h2{
  font-family:var(--m42-font-display); font-weight:800; color:var(--m42-ink);
  font-size:clamp(1.3rem,3.4vh,2.3rem); margin:.1em 0 0; line-height:1.05;
}
.gtitle p{margin:.28em 0 0; font-weight:600; color:var(--m42-ink3); font-size:clamp(.78rem,1.7vh,1.02rem);}
.gtitle .kicker{justify-content:center;}
.stagearea{flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; min-height:0; position:relative;}

/* ============ HOME ============ */
#home{align-items:center; justify-content:center; text-align:center;}
.hometop{display:flex; flex-direction:column; align-items:center; gap:clamp(4px,1vh,10px);}
#home .brand{height:clamp(78px,15vh,150px); width:auto; filter:drop-shadow(0 8px 18px rgba(24,24,15,.13));}
.appname{
  font-family:var(--m42-font-display); font-weight:800; color:var(--m42-ink);
  font-size:clamp(2.4rem,8.4vh,5rem); line-height:.98; margin:clamp(2px,1vh,10px) 0 0;
  letter-spacing:-.015em; position:relative; display:inline-block;
}
.appname .o{color:var(--m42-orange);}
.appname .sq{position:absolute; left:-3%; bottom:-.16em; width:106%; height:.24em;}
.tagline{margin:clamp(14px,2.4vh,26px) 0 0; font-size:clamp(.92rem,2.1vh,1.32rem); font-weight:600; color:var(--m42-body); max-width:24ch;}
.tagline b{color:var(--m42-ink); font-weight:800;}
.homecrew{display:flex; align-items:flex-end; justify-content:center; gap:clamp(2px,1.2vw,16px); margin:clamp(8px,1.6vh,18px) 0 0; height:clamp(80px,17vh,180px);}
.homecrew img{height:100%; width:auto; filter:drop-shadow(0 14px 16px rgba(24,24,15,.16));}
/* mango sits dead centre and stands tallest — it's the hero flavour */
.homecrew img:nth-child(1){animation:float 6.2s ease-in-out infinite 0s;  height:76%;}
.homecrew img:nth-child(2){animation:float 7.4s ease-in-out infinite .5s; height:86%;}
.homecrew img:nth-child(3){animation:float 6.8s ease-in-out infinite .2s; height:100%; z-index:2;
  filter:drop-shadow(0 16px 20px rgba(24,24,15,.22));}
.homecrew img:nth-child(4){animation:float 7.9s ease-in-out infinite .9s; height:86%;}
.homecrew img:nth-child(5){animation:float 6.5s ease-in-out infinite .4s; height:76%;}
@keyframes float{0%,100%{transform:translateY(0) rotate(0)} 50%{transform:translateY(-8px) rotate(-.6deg)}}
@media (prefers-reduced-motion:reduce){ .homecrew img{animation:none;} }
.homebtns{display:flex; flex-direction:column; align-items:center; gap:clamp(10px,1.8vh,18px); margin-top:clamp(12px,2.4vh,26px);}
.shufflenote{font-family:var(--m42-font-hand); color:var(--m42-green-dk); font-size:clamp(1.1rem,2.4vh,1.6rem); opacity:.9;}
.bestline{margin:clamp(8px,1.4vh,14px) 0 0; font-weight:700; color:var(--m42-ink3); font-size:clamp(.75rem,1.6vh,.95rem);}
.homefoot{position:absolute; left:0; right:0; bottom:calc(10px + var(--pad-b)); display:flex; justify-content:center; gap:14px; align-items:center; flex-wrap:wrap;}
.link-order{
  display:inline-flex; align-items:center; gap:9px; text-decoration:none;
  background:#fff; border:1.5px solid var(--m42-border); border-radius:9999px;
  padding:9px 18px; font-weight:800; color:var(--m42-ink); font-size:clamp(.7rem,1.5vh,.86rem);
  box-shadow:var(--m42-shadow-soft);
}
.link-order .u{color:var(--m42-orange);}
.homecorner{position:absolute; top:calc(14px + var(--pad-t)); right:clamp(16px,3vw,42px); display:flex; gap:10px;}

/* ============ MEMORY ============ */
.mgrid{display:grid; gap:clamp(7px,1.4vmin,16px); width:min(90vw,84vh); aspect-ratio:4/3;}
@media (orientation:portrait){ .mgrid{grid-template-columns:repeat(3,1fr); width:min(88vw,48vh); aspect-ratio:3/4;} }
@media (orientation:landscape){ .mgrid{grid-template-columns:repeat(4,1fr);} }
.mcard{position:relative; perspective:800px; cursor:pointer;}
.mcard .inner{
  position:absolute; inset:0; transform-style:preserve-3d;
  transition:transform .42s cubic-bezier(.3,.8,.35,1);
}
.mcard.up .inner, .mcard.matched .inner{transform:rotateY(180deg);}
.mface{
  position:absolute; inset:0; backface-visibility:hidden; -webkit-backface-visibility:hidden;
  border-radius:clamp(12px,2vmin,20px); display:grid; place-items:center; overflow:hidden;
}
.mback{
  background:linear-gradient(165deg,#FFF3D6,#FFE9B8);
  border:2px solid #EEDFAE; box-shadow:var(--m42-shadow-soft);
}
.mback span{
  font-family:var(--m42-font-display); font-weight:800; color:var(--m42-orange);
  font-size:clamp(18px,4.4vmin,44px); line-height:1; transform:rotate(-8deg);
  text-shadow:0 2px 0 rgba(255,255,255,.9);
}
.mfront{
  background:#fff; border:2px solid var(--m42-border); transform:rotateY(180deg);
  box-shadow:var(--m42-shadow-soft); padding:8%;
}
.mfront img{width:100%; height:100%; object-fit:contain;}
.mcard.matched .mfront{background:var(--m42-green-tint); border-color:var(--m42-lime);}
.mcard.matched{animation:pop .4s ease;}
@keyframes pop{0%{transform:scale(1)}45%{transform:scale(1.09)}100%{transform:scale(1)}}

/* ============ WORD HUNT ============ */
.wwrap{display:flex; gap:clamp(12px,2.4vw,32px); align-items:center; justify-content:center; width:100%; flex-wrap:wrap;}
@media (orientation:portrait){ .wwrap{flex-direction:column; gap:clamp(10px,2vh,20px);} }
.wgrid{
  display:grid; gap:clamp(3px,.7vmin,7px); background:#fff; padding:clamp(8px,1.5vmin,16px);
  border-radius:26px; border:2px solid var(--m42-border); box-shadow:var(--m42-shadow-card);
  width:min(74vh,62vw); aspect-ratio:1; touch-action:none;
}
@media (orientation:portrait){ .wgrid{width:min(58vh,92vw);} }
.wcell{
  display:grid; place-items:center; border-radius:clamp(7px,1.5vmin,14px);
  font-family:var(--m42-font-display); font-weight:800; color:var(--m42-ink);
  font-size:clamp(14px,3.2vmin,34px); background:var(--m42-cream);
  transition:background .12s, color .12s, transform .12s;
}
.wcell.sel{background:var(--m42-orange); color:#fff; transform:scale(1.06);}
.wcell.found{background:var(--m42-lime); color:#fff;}
.wcell.hint{box-shadow:inset 0 0 0 3px var(--m42-orange);}
.wlist{display:flex; flex-direction:column; gap:clamp(6px,1.2vh,11px); min-width:clamp(120px,17vw,200px);}
@media (orientation:portrait){ .wlist{flex-direction:row; flex-wrap:wrap; justify-content:center; min-width:0;} }
.witem{
  display:flex; align-items:center; gap:9px; background:#fff; border:1.5px solid var(--m42-border);
  border-radius:9999px; padding:clamp(7px,1.3vh,12px) clamp(13px,1.6vw,20px);
  font-weight:800; color:var(--m42-ink); font-size:clamp(.72rem,1.6vh,1rem);
  letter-spacing:.05em; box-shadow:var(--m42-shadow-soft); transition:.2s;
}
.witem .tick{width:16px; height:16px; flex:none; opacity:0; transition:opacity .2s;}
.witem.got{background:var(--m42-green-tint); border-color:var(--m42-lime); color:var(--m42-green-dk); text-decoration:line-through; text-decoration-thickness:2px;}
.witem.got .tick{opacity:1;}

/* ============ SORT ============ */
.sortcard{
  width:min(72vw,38vh); aspect-ratio:1; border-radius:34px; background:#fff;
  border:2px solid var(--m42-border); box-shadow:var(--m42-shadow-card);
  display:grid; place-items:center; padding:6%; position:relative; overflow:hidden;
}
.sortcard.in{animation:dealIn .34s cubic-bezier(.2,.9,.3,1) both;}
@keyframes dealIn{from{transform:translateY(26px) scale(.9); opacity:0} to{transform:none; opacity:1}}
.sortcard img{width:100%; height:100%; object-fit:contain;}
.sortcard svg.line{width:74%; height:74%;}
.sortname{
  position:absolute; left:50%; bottom:5%; transform:translateX(-50%); white-space:nowrap;
  font-family:var(--m42-font-display); font-weight:800; color:var(--m42-ink);
  font-size:clamp(.95rem,2.4vh,1.5rem); background:var(--m42-cream); border:1.5px solid var(--m42-border);
  border-radius:9999px; padding:5px 18px;
}
.sortbtns{display:flex; gap:clamp(14px,3vw,40px); margin-top:clamp(12px,2.4vh,26px); align-items:center;}
.sortbtn{
  display:flex; flex-direction:column; align-items:center; justify-content:center; gap:8px;
  border-radius:26px; padding:clamp(12px,2vh,20px) clamp(14px,2vw,24px);
  width:clamp(132px,19vw,210px);
  font-family:var(--m42-font-display); font-weight:800; text-transform:uppercase;
  font-size:clamp(.95rem,2.2vh,1.4rem); line-height:1; transition:transform .1s ease, box-shadow .1s;
}
.sortbtn svg{width:clamp(26px,4.4vh,42px); height:clamp(26px,4.4vh,42px);}
.sortbtn.skip{background:#fff; color:var(--m42-berry); border:2.5px solid #E7C9D8; box-shadow:0 8px 0 #EADCE3, 0 14px 22px rgba(150,18,84,.12);}
.sortbtn.keep{background:linear-gradient(180deg,#FF7A2E,#FF6F1E 55%,#F0640F); color:#fff; box-shadow:0 9px 0 #9c3f09, 0 16px 26px rgba(194,78,11,.28);}
.sortbtn:active{transform:translateY(6px); box-shadow:none;}
.feedback{
  position:absolute; left:50%; top:50%; transform:translate(-50%,-50%) scale(.7); opacity:0;
  pointer-events:none; z-index:9; text-align:center; transition:.22s cubic-bezier(.2,.9,.3,1);
}
.feedback.show{opacity:1; transform:translate(-50%,-50%) scale(1);}
.feedback .mark{
  width:clamp(80px,15vh,140px); height:clamp(80px,15vh,140px); border-radius:50%; display:grid; place-items:center;
  margin:0 auto; box-shadow:0 14px 34px rgba(24,24,15,.2);
}
.feedback.good .mark{background:var(--m42-green-bright);}
.feedback.bad .mark{background:var(--m42-coral);}
.feedback .mark svg{width:52%; height:52%;}
.factline{
  margin:clamp(10px,1.8vh,18px) auto 0; max-width:min(80vw,44ch); background:#fff;
  border-left:6px solid var(--m42-lime); border-radius:0 14px 14px 0; padding:11px 18px;
  font-weight:600; color:var(--m42-body); font-size:clamp(.78rem,1.7vh,1rem); box-shadow:var(--m42-shadow-soft);
  text-align:left;
}
.tally{display:flex; gap:7px; margin-bottom:clamp(10px,1.8vh,18px);}
.tally i{width:clamp(12px,1.7vh,17px); height:clamp(12px,1.7vh,17px); border-radius:50%; background:#EDE6CC; display:block;}
.tally i.hit{background:var(--m42-green-bright);} .tally i.miss{background:var(--m42-coral);}

/* ============ QUIZ ============ */
.quizwrap{display:flex; align-items:center; gap:clamp(14px,3vw,44px); width:100%; max-width:1100px; justify-content:center;}
@media (orientation:portrait){ .quizwrap{flex-direction:column; gap:clamp(8px,1.6vh,18px);} }
.host{flex:none; width:clamp(90px,18vh,190px);}
.host img{width:100%; filter:drop-shadow(0 14px 16px rgba(24,24,15,.16)); animation:float 6.6s ease-in-out infinite;}
@media (prefers-reduced-motion:reduce){ .host img{animation:none;} }
.qbox{flex:1; max-width:640px; min-width:0;}
.qtext{
  font-family:var(--m42-font-display); font-weight:800; color:var(--m42-ink);
  font-size:clamp(1.05rem,2.9vh,1.9rem); line-height:1.18; margin:0 0 clamp(10px,2vh,20px);
}
.opts{display:flex; flex-direction:column; gap:clamp(8px,1.5vh,14px);}
.opt{
  display:flex; align-items:center; gap:14px; text-align:left; width:100%;
  background:#fff; border:2px solid var(--m42-border); border-radius:20px;
  padding:clamp(12px,2vh,19px) clamp(14px,2vw,22px); font-weight:700; color:var(--m42-ink);
  font-size:clamp(.85rem,1.9vh,1.12rem); box-shadow:var(--m42-shadow-soft);
  transition:transform .1s, border-color .18s, background .18s;
}
.opt:active{transform:scale(.985);}
.opt .kb{
  flex:none; width:clamp(30px,4.4vh,40px); height:clamp(30px,4.4vh,40px); border-radius:50%;
  background:var(--m42-cream-deep); color:var(--m42-green-dk); display:grid; place-items:center;
  font-family:var(--m42-font-display); font-weight:800; font-size:clamp(.85rem,1.9vh,1.1rem);
}
.opt.right{background:var(--m42-green-tint); border-color:var(--m42-green-bright);}
.opt.right .kb{background:var(--m42-green-bright); color:#fff;}
.opt.wrong{background:#FDEDEC; border-color:var(--m42-coral);}
.opt.wrong .kb{background:var(--m42-coral); color:#fff;}
.opts.locked .opt{pointer-events:none;}

/* ============ INTERSTITIAL / RESULTS ============ */
.center{align-items:center; justify-content:center; text-align:center;}
.bigstars{display:flex; gap:clamp(6px,1.4vw,16px); justify-content:center; margin:clamp(10px,2vh,20px) 0 0;}
.bigstars svg{width:clamp(38px,8vh,80px); height:clamp(38px,8vh,80px);}
.bigstars .s{opacity:.22; transform:scale(.8); transition:.4s cubic-bezier(.2,1.4,.4,1);}
.bigstars .s.on{opacity:1; transform:scale(1);}
.bigmsg{
  font-family:var(--m42-font-display); font-weight:800; color:var(--m42-ink);
  font-size:clamp(1.8rem,6vh,3.6rem); line-height:1; margin:clamp(10px,2vh,20px) 0 0;
}
.bigmsg .o{color:var(--m42-orange);}
.submsg{margin:clamp(8px,1.5vh,16px) 0 0; font-weight:600; color:var(--m42-body); font-size:clamp(.85rem,2vh,1.2rem); max-width:34ch;}
.cheer{width:clamp(90px,20vh,210px); animation:cheer 1.1s ease-in-out infinite;}
@keyframes cheer{0%,100%{transform:translateY(0) rotate(-3deg)}50%{transform:translateY(-12px) rotate(3deg)}}
@media (prefers-reduced-motion:reduce){ .cheer{animation:none;} }

/* results */
.rescard{
  width:min(800px,95vw); padding:clamp(18px,3vh,32px) clamp(18px,2.6vw,34px); text-align:center;
  max-height:calc(100dvh - 2 * (14px + var(--pad-t))); overflow-y:auto; -webkit-overflow-scrolling:touch;
}
.totalline{
  font-family:var(--m42-font-poster); text-transform:uppercase; color:var(--m42-ink);
  font-size:clamp(1.6rem,5vh,3rem); line-height:1; margin:clamp(4px,1vh,10px) 0 0; letter-spacing:.01em;
}
.totalline .o{color:var(--m42-orange);}
.ratequestion{
  font-family:var(--m42-font-display); font-weight:800; color:var(--m42-ink);
  font-size:clamp(1.15rem,2.9vh,1.8rem); margin:clamp(10px,1.8vh,18px) 0 clamp(6px,1vh,10px);
}
.tasteintro{
  margin:0 auto clamp(10px,1.8vh,18px); max-width:40ch; font-weight:600; color:var(--m42-body);
  font-size:clamp(.76rem,1.6vh,.98rem);
}

/* ---- taste test: one row per flavour ---- */
.flavours{
  display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:clamp(7px,1.2vh,12px);
}
@media (orientation:portrait){ .flavours{grid-template-columns:1fr;} }
.frow{
  display:flex; align-items:center; gap:clamp(8px,1.2vw,14px); text-align:left;
  background:var(--m42-cream); border:1.5px solid var(--m42-border); border-radius:16px;
  padding:clamp(7px,1.2vh,12px) clamp(10px,1.4vw,15px); transition:background .2s, border-color .2s;
}
.frow.rated{background:#fff; border-color:var(--m42-lime);}
.frow .swatch{
  width:clamp(11px,1.6vh,15px); height:clamp(11px,1.6vh,15px); border-radius:50%; flex:none;
  box-shadow:0 0 0 3px rgba(255,255,255,.9);
}
.frow .fname{
  flex:1 0 auto; font-family:var(--m42-font-display); font-weight:800; color:var(--m42-ink);
  font-size:clamp(.8rem,1.65vh,1.04rem); white-space:nowrap;
}
.fstars{display:flex; gap:clamp(1px,.3vw,4px); flex:0 1 auto; margin-left:auto;}
.fstars button{
  width:clamp(24px,3.8vh,34px); height:clamp(24px,3.8vh,34px); display:grid; place-items:center;
  flex:none; transition:transform .14s cubic-bezier(.2,1.5,.4,1);
}
.fstars button svg{width:100%; height:100%;}
.fstars button .fill{fill:#E4DCBE; transition:fill .18s;}
.fstars button.on .fill{fill:var(--m42-orange);}
.fstars button.on{transform:scale(1.1);}

/* stall dashboard */
.adminrow{
  display:flex; align-items:center; gap:12px; padding:9px 0; border-bottom:1px solid var(--m42-border);
  font-weight:700; color:var(--m42-ink); font-size:clamp(.78rem,1.7vh,1rem);
}
.adminrow:last-child{border-bottom:0;}
.adminrow .swatch{width:12px; height:12px; border-radius:50%; flex:none;}
.adminrow .nm{flex:1;}
.adminrow .av{font-family:var(--m42-font-display); font-weight:800; color:var(--m42-orange);}
.adminrow .ct{color:var(--m42-ink3); font-weight:600; font-size:.85em; min-width:6ch; text-align:right;}
.adminbar{height:8px; border-radius:9999px; background:#EDE6CC; width:clamp(60px,12vw,120px); overflow:hidden; flex:none;}
.adminbar i{display:block; height:100%; border-radius:9999px;}
.savednote{margin:clamp(6px,1.2vh,12px) 0 0; font-size:clamp(.68rem,1.4vh,.8rem); color:var(--m42-ink3); font-weight:600;}
/* ---- scan-to-follow QR ---- */
.qrcard{
  display:flex; align-items:center; gap:clamp(14px,2.4vw,28px); text-align:left;
  background:var(--m42-cream); border:1.5px solid var(--m42-border); border-radius:22px;
  padding:clamp(12px,2vh,20px) clamp(14px,2vw,24px); margin:clamp(14px,2.4vh,24px) 0 0;
}
.qrbox{
  width:clamp(96px,15vh,140px); aspect-ratio:1; flex:none; background:#fff;
  border:5px solid var(--m42-cream-deep); border-radius:18px; padding:clamp(7px,1.1vh,11px);
  box-shadow:inset 0 0 0 2px #fff, 0 6px 18px rgba(24,24,15,.10); position:relative;
}
.qrbox img{width:100%; height:100%; display:block; image-rendering:pixelated;}
.qrbadge{
  position:absolute; left:50%; top:50%; transform:translate(-50%,-50%);
  width:20%; height:20%; background:#fff; border-radius:8px; display:grid; place-items:center;
  box-shadow:0 2px 8px rgba(24,24,15,.18);
}
.qrbadge span{font-family:var(--m42-font-display); font-weight:800; color:var(--m42-orange); font-size:clamp(10px,1.6vh,15px); line-height:1;}
.qrtext{min-width:0;}
.qrlead{
  margin:0 0 3px; font-weight:800; text-transform:uppercase; letter-spacing:.16em;
  color:var(--m42-orange); font-size:clamp(.6rem,1.15vh,.74rem);
}
.qrhandle{
  margin:0 0 6px; font-family:var(--m42-font-display); font-weight:800; color:var(--m42-ink);
  font-size:clamp(1.05rem,2.5vh,1.6rem); line-height:1.05;
}
.qrscan{
  margin:0; display:flex; align-items:center; gap:8px; font-weight:700; color:var(--m42-ink3);
  font-size:clamp(.7rem,1.45vh,.88rem);
}
.qrscan svg{width:clamp(15px,2vh,19px); height:clamp(15px,2vh,19px); flex:none;}

.reslinks{display:flex; flex-direction:column; gap:clamp(9px,1.6vh,14px); margin-top:clamp(14px,2.4vh,24px);}
.countdown{margin:clamp(8px,1.4vh,14px) 0 0; font-family:var(--m42-font-hand); color:var(--m42-green-dk); font-size:clamp(1rem,2.2vh,1.45rem);}

/* ---- Play + Skip side by side on home ---- */
.homebtnrow{display:flex; align-items:center; gap:clamp(10px,1.6vw,18px); flex-wrap:wrap; justify-content:center;}
.skipbtn{
  font-family:var(--m42-font-display); font-weight:800; text-transform:uppercase; letter-spacing:.01em;
  color:var(--m42-ink3); font-size:clamp(.9rem,2vh,1.2rem);
  padding:clamp(13px,2vh,19px) clamp(20px,3vw,34px); border-color:#E6E0CB;
}

/* ---- phone number on the taste test ---- */
.phonerow{margin:clamp(12px,2vh,20px) 0 0; text-align:left;}
.phonelabel{
  display:block; font-weight:800; color:var(--m42-ink); font-size:clamp(.74rem,1.5vh,.9rem);
  margin:0 0 6px;
}
.phonelabel span{font-weight:600; color:var(--m42-ink3);}
.phonefield{
  display:flex; align-items:center; gap:0; background:var(--m42-cream);
  border:1.5px solid var(--m42-border); border-radius:14px; overflow:hidden;
  transition:border-color .15s, background .15s;
}
.phonefield:focus-within{border-color:var(--m42-orange); background:#fff;}
.phonefield.bad{border-color:var(--m42-coral); background:#FDEDEC;}
.phonefield .cc{
  flex:none; padding:0 12px; font-family:var(--m42-font-display); font-weight:800;
  color:var(--m42-green-dk); font-size:clamp(.85rem,1.8vh,1.05rem);
  border-right:1.5px solid var(--m42-border);
  align-self:stretch; display:flex; align-items:center;
}
.phonefield input{
  flex:1; min-width:0; border:0; outline:none; background:transparent;
  font-family:var(--m42-font-body); font-weight:700; color:var(--m42-ink);
  font-size:clamp(.9rem,1.9vh,1.1rem); letter-spacing:.06em;
  padding:clamp(10px,1.6vh,14px) 12px;
}
.phonefield input::placeholder{color:#B8B2A0; font-weight:500; letter-spacing:.04em;}
.phoneerr{
  margin:5px 0 0; min-height:1.1em; font-weight:700; color:var(--m42-coral);
  font-size:clamp(.68rem,1.35vh,.8rem);
}
.phoneerr.ok{color:var(--m42-green-dk);}

/* ---- small staff button (bottom-left, away from PLAY) ---- */
.stallbtn{
  position:absolute; left:clamp(16px,3vw,42px); bottom:calc(10px + var(--pad-b));
  display:inline-flex; align-items:center; gap:7px;
  background:#fff; border:1.5px solid var(--m42-border); border-radius:9999px;
  padding:8px 13px 8px 11px; font-family:var(--m42-font-body); font-weight:800;
  color:var(--m42-ink3); font-size:clamp(.66rem,1.35vh,.8rem); letter-spacing:.02em;
  box-shadow:var(--m42-shadow-soft); opacity:.72; transition:opacity .2s, transform .1s;
}
.stallbtn:active{transform:scale(.94); opacity:1;}
.stallbtn svg{width:clamp(13px,1.8vh,16px); height:clamp(13px,1.8vh,16px); flex:none;}
.stallbtn .lock{display:inline-flex; color:var(--m42-orange);}
.stallbtn .lock svg{width:clamp(11px,1.5vh,13px); height:clamp(11px,1.5vh,13px);}

/* ---- PIN pad ---- */
.pinwrap{
  position:fixed; inset:0; z-index:80; display:none; place-items:center;
  background:rgba(24,24,15,.55); -webkit-backdrop-filter:blur(4px); backdrop-filter:blur(4px);
  padding:16px;
}
.pinwrap.on{display:grid; animation:fadeIn .2s ease both;}
.pincard{
  width:min(340px,92vw); max-height:calc(100dvh - 32px); overflow-y:auto;
  background:#fff; border:1px solid var(--m42-border); border-radius:26px;
  box-shadow:var(--m42-shadow-card); padding:clamp(18px,3vh,28px); text-align:center;
}
.pincard.shake{animation:shake .4s;}
@keyframes shake{10%,90%{transform:translateX(-3px)}20%,80%{transform:translateX(6px)}
  30%,50%,70%{transform:translateX(-9px)}40%,60%{transform:translateX(9px)}}
.pindots{display:flex; gap:12px; justify-content:center; margin:clamp(12px,2vh,18px) 0;}
.pindots i{
  width:14px; height:14px; border-radius:50%; background:#EDE6CC; display:block;
  transition:background .15s, transform .15s;
}
.pindots i.on{background:var(--m42-orange); transform:scale(1.15);}
.pinpad{display:grid; grid-template-columns:repeat(3,1fr); gap:clamp(7px,1.3vh,11px); margin-bottom:clamp(10px,1.8vh,16px);}
.pinpad button{
  height:clamp(48px,7.2vh,62px); border-radius:16px; background:var(--m42-cream);
  border:1.5px solid var(--m42-border); font-family:var(--m42-font-display);
  font-weight:800; color:var(--m42-ink); font-size:clamp(1.1rem,2.6vh,1.5rem);
  transition:transform .08s, background .15s;
}
.pinpad button:active{transform:scale(.94); background:var(--m42-cream-deep);}
.pinpad button.wide{grid-column:span 1; color:var(--m42-ink3); font-size:clamp(.95rem,2.1vh,1.2rem);}

/* toast + confetti */
.toast{
  position:fixed; left:50%; bottom:38px; transform:translate(-50%,180%); opacity:0; z-index:99;
  background:var(--m42-ink); color:#fff; padding:14px 24px; border-radius:9999px; font-weight:700;
  font-size:.95rem; box-shadow:0 12px 30px rgba(0,0,0,.3); transition:transform .35s cubic-bezier(.2,.8,.2,1), opacity .3s;
  pointer-events:none; max-width:80vw; text-align:center;
}
.toast.show{transform:translate(-50%,0); opacity:1;}
.confetti{position:fixed; inset:0; pointer-events:none; z-index:60; overflow:hidden;}
.confetti i{position:absolute; width:11px; height:15px; border-radius:3px; animation:fall linear forwards;}
@keyframes fall{to{transform:translateY(112vh) rotate(760deg); opacity:.85}}

.footline{
  position:absolute; left:0; right:0; bottom:calc(6px + var(--pad-b)); text-align:center;
  font-family:var(--m42-font-hand); color:var(--m42-green-dk); font-size:clamp(.95rem,2vh,1.4rem); opacity:.75;
  pointer-events:none;
}
</style>
</head>
