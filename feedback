    toast('All reviews cleared');
    showAdmin();
  });

  // tapping a quiet part of the results screen cancels the auto-redirect,
  // but tapping the stars / buttons / links must not
  $('#results').addEventListener('click', e=>{
    if(e.target.closest('button') || e.target.closest('a')) return;
    cancelAuto();
  });

  // unlock audio on first touch (iOS)
  const unlock = ()=>{ Sound.tap(); window.removeEventListener('touchstart', unlock); window.removeEventListener('mousedown', unlock); };
  window.addEventListener('touchstart', unlock, {once:true});
  window.addEventListener('mousedown', unlock, {once:true});

  // stop iPad rubber-band / double-tap zoom
  document.addEventListener('gesturestart', e=>e.preventDefault());
  document.addEventListener('touchmove', e=>{ if(e.touches.length>1) e.preventDefault(); }, {passive:false});
})();
</script>
</body>
