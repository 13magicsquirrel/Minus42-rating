let autoTimer = null;
let tasted = {};          // { mango:5, jamun:3, ... }

/* ---- Indian mobile number: 10 digits starting 6–9, +91 / 0 prefix tolerated ---- */
function normalisePhone(raw){
  let d = String(raw || '').replace(/\D/g, '');
  if(d.length === 12 && d.slice(0,2) === '91') d = d.slice(2);
  else if(d.length === 11 && d[0] === '0')     d = d.slice(1);
  if(d.length !== 10)      return { ok:false, msg:'Enter all 10 digits' };
  if(!/^[6-9]/.test(d))    return { ok:false, msg:'Indian mobile numbers start with 6, 7, 8 or 9' };
  return { ok:true, value:d };
}
function checkPhone(showEmptyOk){
  const input = $('#phoneInput'), field = input.closest('.phonefield'), err = $('#phoneErr');
  const raw = input.value.trim();
  if(!raw){
    field.classList.remove('bad'); err.className = 'phoneerr'; err.textContent = '';
    return { ok:true, value:'' };                       // optional — blank is fine
  }
  const r = normalisePhone(raw);
  if(r.ok){
    field.classList.remove('bad');
    err.className = 'phoneerr ok'; err.textContent = 'Looks good ✓';
  }else if(showEmptyOk){
    field.classList.add('bad');
    err.className = 'phoneerr'; err.textContent = r.msg;
  }
  return r;
}

function showResults(){
  $('#tasteKicker').textContent = Round.queue.length ? 'Nice playing' : 'Your feedback';
  tasted = {};
  document.querySelectorAll('#flavours .frow').forEach(row=>{
    row.classList.remove('rated');
    row.querySelectorAll('.fstars button').forEach(b=>b.classList.remove('on'));
  });
  $('#tasteHint').textContent = 'Tap the stars next to each flavour';
  // fresh phone field for every visitor
  const pi = $('#phoneInput');
  pi.value = '';
  pi.closest('.phonefield').classList.remove('bad');
  $('#phoneErr').className = 'phoneerr';
  $('#phoneErr').textContent = '';
  $('#tasteStep').style.display = '';
  $('#thanksStep').style.display = 'none';
  $('#countdown').textContent = '';
  clearInterval(autoTimer); autoTimer = null;

  show('results');
  confetti(80); Sound.win();
}

function buildFlavours(){
  const wrap = $('#flavours'); wrap.innerHTML = '';
  FLAVOURS.forEach(f=>{
    const row = el('div','frow');
    row.dataset.key = f.key;
    row.innerHTML =
      '<span class="swatch" style="background:'+f.color+'"></span>'+
      '<span class="fname">'+f.name+'</span>';
    const stars = el('div','fstars');
    for(let i=1;i<=5;i++){
      const b = el('button', null, STAR_SVG);
      b.setAttribute('aria-label', f.name + ': ' + i + ' star' + (i>1?'s':''));
      b.addEventListener('click', ()=>{
        // tapping the same star again clears the flavour (didn't try it)
        const already = tasted[f.key] === i;
        if(already){ delete tasted[f.key]; } else { tasted[f.key] = i; }
        const v = tasted[f.key] || 0;
        stars.querySelectorAll('button').forEach((sb,n)=>sb.classList.toggle('on', n < v));
        row.classList.toggle('rated', v > 0);
        Sound.star();
        const n = Object.keys(tasted).length;
        $('#tasteHint').textContent = n
          ? n + ' flavour' + (n>1?'s':'') + ' rated · tap a star again to undo'
          : 'Tap the stars next to each flavour';
      });
      stars.appendChild(b);
    }
    row.appendChild(stars);
    wrap.appendChild(row);
  });
}

function sendTasteTest(){
  const keys = Object.keys(tasted);
  if(!keys.length){ toast('Rate at least one flavour you tasted ✦'); return; }

  const phone = checkPhone(true);
  if(!phone.ok){ toast('Check the phone number, or leave it blank'); $('#phoneInput').focus(); return; }

  const d = Store.saveTasting(tasted, phone.value);       /* <-- stored here */

  const best = keys.slice().sort((a,b)=>tasted[b]-tasted[a])[0];
  const bestName = (FLAVOURS.find(f=>f.key===best)||{}).name || best;
  $('#tasteSummary').textContent =
    'You rated ' + keys.length + ' flavour' + (keys.length>1?'s':'') +
    ' — top marks to ' + bestName + '. We’ll tell the fruit.';

  $('#tasteStep').style.display = 'none';
  $('#thanksStep').style.display = '';
  Sound.win(); confetti(60);
  startAutoFinish();
}

function startAutoFinish(){
  if(!CONFIG.AUTO_HOME_SECONDS) return;
  clearInterval(autoTimer);
  let left = CONFIG.AUTO_HOME_SECONDS;
  const cd = $('#countdown');
  const paint = ()=>{ cd.textContent = 'back to the start in ' + left + '… tap here to stay'; };
  paint();
  autoTimer = setInterval(()=>{
    left--;
    if(left <= 0){ clearInterval(autoTimer); goHome(); return; }
    paint();
  }, 1000);
}
function cancelAuto(){
  if(!autoTimer) return;
  clearInterval(autoTimer); autoTimer = null;
  $('#countdown').textContent = '';
}
/* reset the kiosk for the next visitor — never leaves the app */
function goHome(){
  clearInterval(autoTimer); autoTimer = null;
  Timer.stop();
  $('#countdown').textContent = '';
  show('home');
}

/* ============================================================
   Staff PIN gate — guards the download / clear controls
   ============================================================ */
const Pin = {
  entered: '', onPass: null,
  open(onPass){
    this.entered = ''; this.onPass = onPass;
    $('#pinMsg').textContent = 'To download or clear the reviews';
    this.paint();
    $('#pinWrap').classList.add('on');
  },
  close(){ $('#pinWrap').classList.remove('on'); this.entered = ''; this.paint(); },
  paint(){
    const dots = $('#pinDots').children;
    for(let i=0;i<dots.length;i++) dots[i].classList.toggle('on', i < this.entered.length);
  },
  push(d){
    if(this.entered.length >= CONFIG.STALL_PIN.length) return;
    this.entered += d; this.paint(); Sound.tap();
    if(this.entered.length === CONFIG.STALL_PIN.length) setTimeout(()=>this.check(), 160);
  },
  back(){ this.entered = this.entered.slice(0,-1); this.paint(); Sound.tap(); },
  check(){
    if(this.entered === CONFIG.STALL_PIN){
      Sound.star();
      const cb = this.onPass;
      this.close();
      if(cb) cb();
    }else{
      Sound.bad();
      const card = $('#pinCard');
      card.classList.remove('shake'); void card.offsetWidth; card.classList.add('shake');
      $('#pinMsg').textContent = 'Wrong PIN — try again';
      this.entered = ''; this.paint();
    }
  }
};

function buildPinPad(){
  const dots = $('#pinDots'); dots.innerHTML = '';
  for(let i=0;i<CONFIG.STALL_PIN.length;i++) dots.appendChild(el('i'));

  const pad = $('#pinPad'); pad.innerHTML = '';
  ['1','2','3','4','5','6','7','8','9'].forEach(n=>{
    const b = el('button', null, n);
    b.addEventListener('click', ()=>Pin.push(n));
    pad.appendChild(b);
  });
  const back = el('button','wide','⌫');
  back.setAttribute('aria-label','Delete');
  back.addEventListener('click', ()=>Pin.back());
  const zero = el('button', null, '0');
  zero.addEventListener('click', ()=>Pin.push('0'));
  const blank = el('button','wide','');
  blank.style.visibility = 'hidden';
  pad.appendChild(back); pad.appendChild(zero); pad.appendChild(blank);
}

