    </div>

    <div class="stagearea" id="stageArea"></div>
    <p class="footline">the science of doing nothing to fruit ✦</p>
  </section>

  <!-- ============ BETWEEN GAMES ============ -->
  <section class="screen center" id="tween">
    <img class="cheer" id="tweenMascot" alt="">
    <div class="bigstars" id="tweenStars"></div>
