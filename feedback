<div class="toast" id="toast"></div>

<script>
/* ============================================================
   Minus42 kiosk feedback
   OPTIONAL: to save ratings, set FEEDBACK_ENDPOINT to a URL that
   accepts a POST {rating, comment}. Leave "" for an on-screen
   thank-you only (nothing leaves the device).
   ============================================================ */
var FEEDBACK_ENDPOINT = "";

(function(){
  var MAX = 10, rating = 0;
  var starsWrap=document.getElementById('stars'), label=document.getElementById('ratingLabel');
  var card=document.getElementById('fbcard'), thanks=document.getElementById('thanks');
  var textEl=document.getElementById('fbtext'), submit=document.getElementById('submitBtn');
  var toast=document.getElementById('toast'), tt;

  var stars=[];
  for(var k=1;k<=MAX;k++){
    var st=document.createElement('span'); st.className='star';
    st.innerHTML='<span class="s b">\u2605</span><span class="s f">\u2605</span>';
    st.dataset.k=k; starsWrap.appendChild(st); stars.push(st);
  }

  var LABELS={1:"Oh no \u2014 tell us why",2:"Not great",3:"Meh",4:"It was okay",5:"Decent",6:"Pretty good",7:"Good stuff",8:"Really tasty!",9:"So good!",10:"Loved it!"};
  function fmt(v){ return (v % 1 ? v.toFixed(1) : v); }
  function labelFor(v){ return v<=0 ? "Tap the stars to rate" : fmt(v)+" / 10 \u2605  \u00b7  "+LABELS[Math.ceil(v)]; }
  function paint(v){ for(var i=0;i<MAX;i++){ var f=stars[i].querySelector('.f'), idx=i+1;
    f.style.width = (v>=idx)?'100%':(v>=idx-0.5?'50%':'0%'); } }
  function setRating(v){ rating=v; paint(v); label.textContent=labelFor(v); starsWrap.setAttribute('aria-valuenow',v); }

  stars.forEach(function(st){
    var k=parseInt(st.dataset.k,10);
    function valAt(e){ var r=st.getBoundingClientRect();
      var x=(e.touches?e.touches[0].clientX:e.clientX)-r.left; return (x<r.width/2)?k-0.5:k; }
    st.addEventListener('mousemove',function(e){ var v=valAt(e); paint(v); label.textContent=labelFor(v); });
    st.addEventListener('click',function(e){ setRating(valAt(e)); });
    st.addEventListener('touchstart',function(e){ setRating(valAt(e)); },{passive:true});
  });
  starsWrap.addEventListener('mouseleave',function(){ paint(rating); label.textContent=labelFor(rating); });

  function showToast(m){ toast.textContent=m; toast.classList.add('show');
    clearTimeout(tt); tt=setTimeout(function(){toast.classList.remove('show');},2800); }
  function reset(){ setRating(0); textEl.value=''; card.classList.remove('done'); thanks.classList.remove('show'); }

  submit.addEventListener('click',function(){
    if(rating<=0){ showToast('Please tap a star rating first'); return; }
    if(FEEDBACK_ENDPOINT){ try{ fetch(FEEDBACK_ENDPOINT,{method:'POST',mode:'no-cors',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({rating:rating,comment:textEl.value||'',at:new Date().toISOString()})}); }catch(e){} }
    card.classList.add('done'); thanks.classList.add('show');
    setTimeout(reset,5000);
  });

  setRating(0);
})();
</script>
</body>
