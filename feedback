function tastingsCsv(){
  const d = Store.read();
  const keys = FLAVOURS.map(f=>f.key);
  const rows = [['when','phone'].concat(keys).join(',')];
  (d.tastings || []).forEach(t=>{
    rows.push([t.at, t.phone || ''].concat(keys.map(k=>(t.flavours && t.flavours[k]) || '')).join(','));
  });
  return rows.join('\n');
}

