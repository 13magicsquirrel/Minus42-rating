      pick(CAST, 5).map(c=>({ good:true,  name:c.name, img:IMG[c.key], fact:c.fact }))
      .concat(pick(JUNK, 5).map(j=>({ good:false, name:j.name, svg:j.svg, fact:j.fact })))
    );

    const card = el('div','sortcard');
    const tally = el('div','tally');
    for(let i=0;i<items.length;i++) tally.appendChild(el('i'));
    const fb = el('div','feedback');
    const btns = el('div','sortbtns');
    const skip = el('button','sortbtn skip',
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>Skip it');
    const keep = el('button','sortbtn keep',
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8h14l-1.4 12.5a2 2 0 0 1-2 1.5H8.4a2 2 0 0 1-2-1.5z"/><path d="M8.5 8V5.5h7V8"/><path d="M9.5 14.5l2 2 3.5-4"/></svg>Freeze it');
    btns.appendChild(skip); btns.appendChild(keep);
    s.appendChild(fb); s.appendChild(tally); s.appendChild(card); s.appendChild(btns);

    let i = 0, correct = 0, lock = false;

    function draw(){
      const it = items[i];
      card.className = 'sortcard in';
      card.innerHTML = it.img
        ? '<img src="'+it.img+'" alt="'+it.name+'">'
        : '<svg class="line" viewBox="0 0 100 100" fill="none" stroke="#18180F" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round">'+it.svg+'</svg>';
      card.appendChild(el('span','sortname', it.name));
    }
    function answer(freeze){
      if(lock || i >= items.length) return;
      lock = true;
      const it = items[i];
      const right = (freeze === it.good);
      if(right){ correct++; Sound.good(); } else { Sound.bad(); }
      tally.children[i].className = right ? 'hit' : 'miss';
      fb.className = 'feedback show ' + (right ? 'good' : 'bad');
      fb.innerHTML =
        '<div class="mark">'+ (right
          ? '<svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5.2 5.2L20 6.6"/></svg>'
          : '<svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3.4" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>') + '</div>'+
        '<div class="factline">'+ (right ? '' : '<b>'+(it.good?'That one’s real food!':'That one’s a sugar trap.')+'</b> ') + it.fact +'</div>';
      setTimeout(()=>{
        fb.classList.remove('show');
        i++;
        if(i >= items.length){
          Sound.win(); confetti(60);
          const quick = Timer.fraction() >= 0.25;
          const stars = 1 + (correct >= 8 ? 1 : 0) + (quick && correct >= 6 ? 1 : 0);
          setTimeout(()=>Round.finishGame(stars, 'You sorted '+correct+' out of '+items.length+' correctly.'), 500);
          return;
        }
        draw(); lock = false;
      }, 2600);
    }
    skip.addEventListener('click', ()=>answer(false));
    keep.addEventListener('click', ()=>answer(true));
    draw();

    Round.clock(()=>{
      lock = true;
      Round.finishGame(1, 'Time! You sorted '+correct+' correctly out of the '+i+' you saw.');
    });
  }
};

